  "description": "Professional crypto trading terminal with support for 100+ exchanges",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "tsx --tsconfig tsconfig.server.json express.ts",
    "server:dev": "tsx watch --tsconfig tsconfig.server.json express.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:8080 && ELECTRON=true vite build --mode development && electron .\"",
    "electron:build": "ELECTRON=true vite build && electron-builder",
    "electron:build:win": "ELECTRON=true vite build && electron-builder --win",
    "electron:build:mac": "ELECTRON=true vite build && electron-builder --mac",
    "electron:build:linux": "ELECTRON=true vite build && electron-builder --linux",
    "electron:preview": "ELECTRON=true vite build && electron ."
  },
