{
  "name": "@profitmaker/module-sdk",
  "version": "1.0.0",
  "description": "SDK for building Profitmaker terminal modules (widgets + backend services)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts",
    "./runtime/react": "./runtime/react.js",
    "./runtime/react-dom": "./runtime/react-dom.js",
    "./runtime/react-dom-client": "./runtime/react-dom-client.js",
    "./runtime/jsx-runtime": "./runtime/jsx-runtime.js",
    "./runtime/jsx-dev-runtime": "./runtime/jsx-dev-runtime.js",
    "./runtime/zustand": "./runtime/zustand.js",
    "./runtime/sdk": "./runtime/sdk.js"
