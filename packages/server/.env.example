# Profitmaker server (packages/server) — environment.
# Copy to .env (gitignored) and fill in. NEVER commit real secrets.

# HTTP server port (Socket.IO runs on PORT + 1).
PORT=3001

# Bearer token for server API auth (agents/scripts/curl → bootstrap user).
API_TOKEN=your-secret-token

# Postgres connection string — REQUIRED to boot the server.
DATABASE_URL=postgres://USER@localhost:5432/profitmaker

# --- Central exchange accounts (auth.marketmaker.cc) -------------------------

# Auth service base: JWKS verification + the user-plane /api/accounts proxy.
AUTH_URL=https://auth.marketmaker.cc

# Base for the SERVER↔AUTH internal credential fetch
# (POST /api/v1/internal/exchange-credentials). Point at a private address in
# prod if available; defaults to AUTH_URL's host.
AUTH_INTERNAL_URL=https://auth.marketmaker.cc

# Server↔auth shared secret for the internal credential fetch.
# MUST EQUAL the auth service's AUTH_INTERNAL_SECRET, or every accountId trade
# fetch fails. Unset ⇒ the central-account accountId flow returns 503 (the rest
# of the server still boots). This is a PROD SECRET — never log it or commit it.
AUTH_INTERNAL_SECRET=
