# Profitmaker server (packages/server) — environment.
# Copy to .env (gitignored) and fill in. NEVER commit real secrets.

# HTTP server port (Socket.IO runs on PORT + 1).
PORT=3001

# Bearer token for server API auth (agents/scripts/curl → bootstrap user).
# Generate your own — e.g. `openssl rand -hex 32` — and never reuse this file's
# placeholder. Leave BLANK to disable static-token auth entirely: unset means the
# path is off, NOT that some default token works. Anyone holding this value has
# full access to the bootstrap user's data.
API_TOKEN=

# Browser origins allowed to open a Socket.IO connection (comma-separated). The
# Socket.IO server listens on PORT + 1, so it is always cross-origin from the
# SPA and this must list the terminal's own public origin in production.
# Unset ⇒ localhost dev origins only.
# e.g. ALLOWED_ORIGINS=https://terminal.marketmaker.cc
ALLOWED_ORIGINS=

# Self-service signup at POST /api/auth/register. OFF unless set to 1/true/yes.
# Every account this server issues is fully privileged, so leave this off on any
# deployment reachable from the internet — on an SSO deployment users arrive
# through auth.marketmaker.cc and never need it.
ALLOW_REGISTRATION=

# Postgres connection string — REQUIRED to boot the server.
DATABASE_URL=postgres://USER@localhost:5432/profitmaker

# --- Central exchange accounts (auth.marketmaker.cc) -------------------------

# Auth service base: JWKS verification + the user-plane /api/accounts proxy.
AUTH_URL=https://auth.marketmaker.cc

# Expected `aud` claim on SSO JWTs. Unset ⇒ audience is not checked, so ANY token
# the auth service signed (including one minted for a sibling service, or a
# refresh token) is accepted here as long as its other claims fit. Set this once
# the auth service issues audience-scoped tokens for the terminal.
AUTH_AUDIENCE=

# Base for the SERVER↔AUTH internal credential fetch
# (POST /api/v1/internal/exchange-credentials). Point at a private address in
# prod if available; defaults to AUTH_URL's host.
AUTH_INTERNAL_URL=https://auth.marketmaker.cc

# Server↔auth shared secret for the internal credential fetch.
# MUST EQUAL the auth service's AUTH_INTERNAL_SECRET, or every accountId trade
# fetch fails. Unset ⇒ the central-account accountId flow returns 503 (the rest
# of the server still boots). This is a PROD SECRET — never log it or commit it.
AUTH_INTERNAL_SECRET=

# Pure postpaid usage analytics. Socket.IO delivery never waits for auth-service;
# pricing refresh and cumulative usage batches run in background.
USAGE_METERING_ENABLED=0
